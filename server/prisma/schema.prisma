// Sentinel Supplier Assurance Platform — Prisma Schema
// Day 2 — Full schema; IDs: SUP-, AUD-, TYP-, FIN-, CAR-
// Database: Supabase (set DATABASE_URL in server/.env and root .env).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== Auth & Users ==============
model Role {
  id        String    @id @default(cuid())
  name      String    @unique // Admin, Viewer, QualityEngineer, Auditor, Buyer, Supplier
  userRoles UserRole[]
  pagePermissions RolePagePermission[]
}

model RolePagePermission {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  pageKey   String
  canAccess Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, pageKey])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userRoles    UserRole[]
  buyerSuppliers BuyerSupplier[]  @relation("BuyerAssignments")
  supplier     Supplier?          @relation("SupplierUser")
  recordsUploaded Record[]
  findingsCreated Finding[]
  carsCreated  CorrectiveAction[]
  carApprovalLogs CarApprovalLog[]
  opportunitiesCreated Opportunity[]
  alerts       Alert[]
  alertPrefs   UserAlertPreference[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

// ============== Suppliers & Buyers ==============
model CommodityType {
  id        String    @id @default(cuid())
  name      String
  suppliers Supplier[]
}

// Admin-managed list; Finding.defectCode / CAR.defectCode store the chosen code string.
model DefectCode {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-managed list; Finding.dispositionCode stores the chosen code string.
model DispositionCode {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id              String    @id @default(cuid())
  code            String    @unique // SUP-00001
  name            String
  city            String?
  country         String?
  status          SupplierStatus @default(Active)
  notes           String?
  commodityTypeId String?
  commodityType   CommodityType? @relation(fields: [commodityTypeId], references: [id])
  userId          String?   @unique // for Supplier role login
  user            User?     @relation("SupplierUser", fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  buyerSuppliers  BuyerSupplier[]
  audits          Audit[]
  findings        Finding[]
  correctiveActions CorrectiveAction[]
  shipments       Shipment[]
  records         Record[]
  riskSnapshots   RiskSnapshot[]
  opportunities   Opportunity[]
  shipmentSchedules ShipmentSchedule[]
}

enum SupplierStatus {
  Active
  Inactive
}

model BuyerSupplier {
  buyerId    String
  supplierId String
  buyer      User     @relation("BuyerAssignments", fields: [buyerId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  @@id([buyerId, supplierId])
}

// ============== Audits & Findings & CARs ==============
model AuditType {
  id     String  @id @default(cuid())
  code   String  @unique // TYP-00
  name   String?
  audits Audit[]
}

model Audit {
  id           String    @id @default(cuid())
  code         String    @unique // AUD-00001
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  auditTypeId  String?
  auditType    AuditType? @relation(fields: [auditTypeId], references: [id])
  auditDate    DateTime  @db.Date
  auditor      String?
  result       AuditResult? // Passed, Failed, Cancelled
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  findings     Finding[]
  correctiveActions CorrectiveAction[]
  records      Record[]
}

enum AuditResult {
  Passed
  Failed
  Cancelled
}

model Finding {
  id                      String        @id @default(cuid())
  code                    String        @unique // FIN-00001
  auditId                 String?
  audit                   Audit?        @relation(fields: [auditId], references: [id], onDelete: SetNull)
  supplierId              String
  supplier                Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status                  FindingStatus @default(New)
  severity                FindingSeverity
  summary                 String
  discrepancy             String
  defectCode              String?
  dispositionCode         String?
  containment             String?
  occurrenceRootCause     String?
  escapeRootCause         String?
  correctiveAction        String?
  verificationOfEffectiveness String?
  closingComments         String?
  createdById             String?
  createdBy               User?         @relation(fields: [createdById], references: [id])
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  correctiveActions       CorrectiveAction[]
}

enum FindingStatus {
  New
  DRAFT
  WaitingDisposition
  WaitingApproval
  Closed
}

enum FindingSeverity {
  Critical
  Major
  Minor
}

model CorrectiveAction {
  id                          String    @id @default(cuid())
  code                        String    @unique // CAR-00001
  findingId                   String?
  finding                     Finding?  @relation(fields: [findingId], references: [id], onDelete: SetNull)
  auditId                     String
  audit                       Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  supplierId                  String
  supplier                    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status                      CARStatus @default(DRAFT)
  severity                    FindingSeverity
  carOwner                    String?
  targetCompletionDate        DateTime? @db.Date
  summary                     String
  discrepancy                 String
  defectCode                  String?
  containment                 String?
  occurrenceRootCause         String?
  escapeRootCause             String?
  correctiveAction            String?
  verificationOfEffectiveness  String?
  closingComments             String?
  approvalLogs                CarApprovalLog[]
  createdById                 String?
  createdBy                   User?     @relation(fields: [createdById], references: [id])
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model CarApprovalLog {
  id         String           @id @default(cuid())
  carId      String
  car        CorrectiveAction @relation(fields: [carId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  comment    String?
  createdAt  DateTime         @default(now())
}

enum CARStatus {
  DRAFT
  RCCA
  WaitingApproval
  FollowUp
  Closed
}

// ============== Shipments ==============
model Shipment {
  id              String          @id @default(cuid())
  supplierId      String
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder   String?
  partNumber      String?
  qty             Int?
  inspectionDate  DateTime?       @db.Date
  status          ShipmentStatus @default(WaitingInspection)
  result          ShipmentResult? // Passed, Failed (set by Admin/QE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum ShipmentStatus {
  WaitingInspection
  Passed
  Failed
}

enum ShipmentResult {
  Passed
  Failed
}

model ShipmentSchedule {
  id             String   @id @default(cuid())
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder  String?
  partNumber     String?
  qty            Int?
  scheduledDate  DateTime? @db.Date
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============== Records & Documents ==============
model Record {
  id               String      @id @default(cuid())
  name             String
  internalOrSupplier RecordSource
  supplierId       String?
  supplier         Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  auditId          String?
  audit            Audit?      @relation(fields: [auditId], references: [id], onDelete: SetNull)
  status          RecordStatus @default(PENDING)
  filePath        String?
  fileName        String?
  fileMime        String?
  fileData        Bytes?
  uploadedById    String?
  uploadedBy      User?        @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum RecordSource {
  internal
  supplier
}

enum RecordStatus {
  PENDING
  Approved
  Rejected
}

model Document {
  id             String       @id @default(cuid())
  documentNumber String
  name           String
  category       String?
  documentType   DocumentType
  filePath       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum DocumentType {
  Procedure
  Policy
  StandardOperatingProcedure
  WorkInstruction
  Form
}

model InternalDoc {
  id        String   @id @default(cuid())
  name      String
  category  String?
  note      String?
  filePath  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============== Risk ==============
model RiskWeightConfig {
  id                  String @id @default(cuid())
  qualityPercent      Float  @default(20)
  auditPercent        Float  @default(20)
  deliveryPercent     Float  @default(20)
  carClosurePercent   Float  @default(20)
  documentationPercent Float @default(20)
  updatedAt           DateTime @updatedAt
}

model RiskSnapshot {
  id         String    @id @default(cuid())
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  score      Float?
  level      RiskLevel
  createdAt  DateTime  @default(now())
}

enum RiskLevel {
  Low
  Medium
  High
}

model Opportunity {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type        RiskItemType
  description String
  likelihood  RiskLikelihood?
  severity    RiskSeverity?
  riskLevel   RiskLevel?
  status      RiskStatus @default(Open)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum RiskItemType {
  risk
  opportunity
}

enum RiskStatus {
  Open
  Mitigated
  Closed
}

enum RiskLikelihood {
  VeryUnlikely
  Unlikely
  Possible
  Likely
  VeryLikely
}

enum RiskSeverity {
  Negligible
  Minor
  Moderate
  Significant
  Severe
}

// ============== Alerts ==============
model Alert {
  id         String       @id @default(cuid())
  category   AlertCategory
  entityType String?      // e.g. Audit, Finding, CAR, Shipment
  entityId   String?
  message    String?
  userId     String?      // if user-specific
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
}

enum AlertCategory {
  overdueAudit
  majorCriticalFinding
  overdueCAR
  shipmentInspectionRequest
  rejectedShipmentDocument
  lateShipment
}

model UserAlertPreference {
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertCategory AlertCategory
  enabled      Boolean @default(true)
  @@id([userId, alertCategory])
}

// For application-level code generation (SUP-00001, AUD-00001, etc.)
model IdSequence {
  prefix    String @id // SUP, AUD, TYP, FIN, CAR
  lastValue Int    @default(0)
}
