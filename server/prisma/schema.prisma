// Sentinel Supplier Assurance Platform — Prisma Schema
// Day 2 — Full schema; IDs: SUP-, AUD-, TYP-, FIN-, CAR-
// Database: Supabase (set DATABASE_URL in server/.env and root .env).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Uses server/.env DIRECT_URL (db.*.supabase.co:5432). Migrate/resolve must not use :6543 pooler alone.
  directUrl = env("DIRECT_URL")
}

// ============== Auth & Users ==============
model Role {
  id        String    @id @default(cuid())
  name      String    @unique // Admin, Viewer, QualityEngineer, Auditor, Buyer, Supplier
  userRoles UserRole[]
  pagePermissions RolePagePermission[]
}

model RolePagePermission {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  pageKey   String
  canAccess Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, pageKey])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  // Encrypted at rest so Admin can view the original password in the User table.
  // This is sensitive data; keep PASSWORD_ENCRYPTION_KEY secret.
  passwordEncrypted String?
  name         String?
  isEmployee   Boolean   @default(false)
  isContractor Boolean   @default(false)
  employmentStatus String @default("Active")
  hourlyRate   Float?
  currency     String?
  country      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userRoles    UserRole[]
  buyerSuppliers BuyerSupplier[]  @relation("BuyerAssignments")
  qeSuppliers  QeSupplier[]       @relation("QeAssignments")
  supplier     Supplier?          @relation("SupplierUser")
  auditorSuppliers AuditorSupplier[] @relation("AuditorAssignments")
  employeeSuppliers EmployeeSupplierAssignment[] @relation("EmployeeSupplierAssignments")
  recordsUploaded Record[]
  findingsCreated Finding[]
  carsCreated  CorrectiveAction[]
  carApprovalLogs CarApprovalLog[]
  findingApprovalLogs FindingApprovalLog[]
  opportunitiesCreated Opportunity[]
  riskActionsCreated RiskAction[]
  alerts       Alert[]
  alertPrefs   UserAlertPreference[]

  qeBuyers QeBuyer[] @relation("QeBuyerQeAssignments")
  qeBuyerBuyers QeBuyer[] @relation("QeBuyerBuyerAssignments")
  qmQes QualityManagerQe[] @relation("QmQeManagerAssignments")
  qmQeEngineers QualityManagerQe[] @relation("QmQeEngineerAssignments")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

// ============== Suppliers & Buyers ==============
model CommodityType {
  id        String    @id @default(cuid())
  name      String
  suppliers Supplier[]
}

// Admin-managed list; Finding.defectCode / CAR.defectCode store the chosen code string.
model DefectCode {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-managed list; Finding.dispositionCode stores the chosen code string.
model DispositionCode {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id              String    @id @default(cuid())
  code            String    @unique // SUP-00001
  name            String
  city            String?
  country         String?
  latitude        Float?
  longitude       Float?
  status          String    @default("Active")
  notes           String?
  commodityTypeId String?
  commodityType   CommodityType? @relation(fields: [commodityTypeId], references: [id])
  userId          String?   @unique // for Supplier role login
  user            User?     @relation("SupplierUser", fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  buyerSuppliers  BuyerSupplier[]
  qeSuppliers     QeSupplier[]
  auditorSuppliers AuditorSupplier[]
  employeeSuppliers EmployeeSupplierAssignment[]
  audits          Audit[]
  findings        Finding[]
  correctiveActions CorrectiveAction[]
  shipments       Shipment[]
  records         Record[]
  riskSnapshots   RiskSnapshot[]
  opportunities   Opportunity[]
  riskActions     RiskAction[]
  shipmentSchedules ShipmentSchedule[]
  workLogs        WorkLog[]
}

model BuyerSupplier {
  buyerId    String
  supplierId String
  buyer      User     @relation("BuyerAssignments", fields: [buyerId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  @@id([buyerId, supplierId])
}

model QeSupplier {
  qualityEngineerId String
  supplierId        String
  qualityEngineer   User     @relation("QeAssignments", fields: [qualityEngineerId], references: [id], onDelete: Cascade)
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  @@id([qualityEngineerId, supplierId])
}

model AuditorSupplier {
  auditorId   String
  supplierId  String
  auditor     User     @relation("AuditorAssignments", fields: [auditorId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  @@id([auditorId, supplierId])
}

model EmployeeSupplierAssignment {
  employeeId String
  supplierId String
  employee   User     @relation("EmployeeSupplierAssignments", fields: [employeeId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([employeeId, supplierId])
}

model QeBuyer {
  qualityEngineerId String
  buyerId           String

  qualityEngineer User @relation("QeBuyerQeAssignments", fields: [qualityEngineerId], references: [id], onDelete: Cascade)
  buyer           User @relation("QeBuyerBuyerAssignments", fields: [buyerId], references: [id], onDelete: Cascade)
  @@id([qualityEngineerId, buyerId])
}

model QualityManagerQe {
  qualityManagerId  String
  qualityEngineerId String

  qualityManager  User @relation("QmQeManagerAssignments", fields: [qualityManagerId], references: [id], onDelete: Cascade)
  qualityEngineer User @relation("QmQeEngineerAssignments", fields: [qualityEngineerId], references: [id], onDelete: Cascade)

  @@id([qualityManagerId, qualityEngineerId])
}

// ============== Audits & Findings & CARs ==============
model AuditType {
  id     String  @id @default(cuid())
  code   String  @unique // TYP-00
  name   String?
  audits Audit[]
}

model Audit {
  id           String    @id @default(cuid())
  code         String    @unique // AUD-00001
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  auditTypeId  String?
  auditType    AuditType? @relation(fields: [auditTypeId], references: [id])
  auditDate    DateTime  @db.Date
  auditor      String?
  result       AuditResult? // Passed, Failed, Cancelled
  summary      String?
  scope        String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  findings     Finding[]
  correctiveActions CorrectiveAction[]
  records      Record[]
  workLogs     WorkLog[]
}

enum AuditResult {
  Passed
  Failed
  Cancelled
}

model Finding {
  id                      String        @id @default(cuid())
  code                    String        @unique // FIN-00001
  auditId                 String?
  audit                   Audit?        @relation(fields: [auditId], references: [id], onDelete: SetNull)
  shipmentId              String?
  shipment                Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  supplierId              String
  supplier                Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status                  FindingStatus @default(New)
  severity                FindingSeverity
  summary                 String
  discrepancy             String
  defectCode              String?
  dispositionCode         String?
  containment             String?
  occurrenceRootCause     String?
  escapeRootCause         String?
  correctiveAction        String?
  verificationOfEffectiveness String?
  closingComments         String?
  createdById             String?
  createdBy               User?         @relation(fields: [createdById], references: [id])
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  correctiveActions       CorrectiveAction[]
  approvalLogs            FindingApprovalLog[]
}

model FindingApprovalLog {
  id         String   @id @default(cuid())
  findingId  String
  finding    Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  comment    String?
  createdAt  DateTime @default(now())
}

enum FindingStatus {
  New
  DRAFT
  WaitingDisposition
  WaitingApproval
  Closed
}

enum FindingSeverity {
  Critical
  Major
  Minor
}

model CorrectiveAction {
  id                          String    @id @default(cuid())
  code                        String    @unique // CAR-00001
  findingId                   String?
  finding                     Finding?  @relation(fields: [findingId], references: [id], onDelete: SetNull)
  auditId                     String
  audit                       Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  supplierId                  String
  supplier                    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status                      CARStatus @default(DRAFT)
  severity                    FindingSeverity
  carOwner                    String?
  targetCompletionDate        DateTime? @db.Date
  summary                     String
  discrepancy                 String
  defectCode                  String?
  containment                 String?
  occurrenceRootCause         String?
  escapeRootCause             String?
  correctiveAction            String?
  verificationOfEffectiveness  String?
  closingComments             String?
  approvalLogs                CarApprovalLog[]
  records                     Record[]
  createdById                 String?
  createdBy                   User?     @relation(fields: [createdById], references: [id])
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model CarApprovalLog {
  id         String           @id @default(cuid())
  carId      String
  car        CorrectiveAction @relation(fields: [carId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  comment    String?
  createdAt  DateTime         @default(now())
}

enum CARStatus {
  DRAFT
  RCCA
  WaitingApproval
  FollowUp
  Closed
}

// ============== Shipments ==============
model Shipment {
  id              String          @id @default(cuid())
  code            String?         @unique
  supplierId      String
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder   String?
  partNumber      String?
  lot             String?
  qty             Int?
  inspectionDate  DateTime?       @db.Date
  status          ShipmentStatus @default(WaitingInspection)
  result          ShipmentResult? // Passed, Failed (set by Admin/QE)
  inspector       String?
  createdBy      String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  workLogs        WorkLog[]
  records         Record[]
  findings        Finding[]
}

model WorkLog {
  id          String   @id @default(cuid())
  code        String   @unique // LOG-00001
  fullName    String
  workDate    DateTime @db.Date
  hoursWorked Float
  workType    WorkType
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  auditId     String?
  audit       Audit?    @relation(fields: [auditId], references: [id], onDelete: SetNull)
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  projectHistoryId String?
  projectHistory   ClientHistory? @relation(fields: [projectHistoryId], references: [id], onDelete: SetNull)
  description String?
  createdAt   DateTime @default(now())
  laborCosts  LaborCost[]
}

model LaborCost {
  id         String     @id @default(cuid())
  code       String     @unique // COST-00001
  workLogId  String?
  workLog    WorkLog?   @relation(fields: [workLogId], references: [id], onDelete: SetNull)
  projectHistoryId String?
  projectHistory   ClientHistory? @relation(fields: [projectHistoryId], references: [id], onDelete: SetNull)
  fullName   String
  hours      Float
  rate       Float
  totalCost  Float
  paidStatus PaidStatus @default(Pending)
  createdAt  DateTime   @default(now())
}

enum PaidStatus {
  Pending
  Paid
}

enum WorkType {
  Audit
  Inspection
  Travel
  Admin
  Other
}

enum ShipmentStatus {
  WaitingInspection
  Passed
  Failed
}

enum ShipmentResult {
  Passed
  Failed
}

model ShipmentSchedule {
  id             String   @id @default(cuid())
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder  String?
  partNumber     String?
  qty            Int?
  scheduledDate  DateTime? @db.Date
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============== Records & Documents ==============
model Record {
  id               String      @id @default(cuid())
  name             String
  notes            String?
  internalOrSupplier RecordSource
  supplierId       String?
  supplier         Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  auditId          String?
  audit            Audit?      @relation(fields: [auditId], references: [id], onDelete: SetNull)
  shipmentId       String?
  shipment         Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  carId            String?
  car              CorrectiveAction? @relation(fields: [carId], references: [id], onDelete: SetNull)
  status          RecordStatus @default(PENDING)
  filePath        String?
  fileName        String?
  fileMime        String?
  fileData        Bytes?
  uploadedById    String?
  uploadedBy      User?        @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum RecordSource {
  internal
  supplier
}

enum RecordStatus {
  PENDING
  Approved
  Rejected
}

model Document {
  id             String       @id @default(cuid())
  documentNumber String
  name           String
  category       String?
  documentType   DocumentType
  filePath       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum DocumentType {
  Procedure
  Policy
  QualityManual
  Standard
  StandardOperatingProcedure
  WorkInstruction
  Form
}

model InternalDoc {
  id        String   @id @default(cuid())
  name      String
  category  String?
  note      String?
  filePath  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Client / engagement records for Internal Management — Client History tab.
model ClientHistory {
  id                   String   @id @default(cuid())
  projectCode          String   @unique
  clientName           String
  companyName          String
  clientEmail          String?
  clientMobile         String?
  industry             String?
  country              String?
  projectDescription   String?
  periodOfPerformance  String?
  revenue              String?
  revenueAmount        Float?
  /// Active or Inactive
  status               String   @default("Active")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  workLogs             WorkLog[]
  laborCosts           LaborCost[]
}

// ============== Risk ==============
model RiskWeightConfig {
  id                  String @id @default(cuid())
  qualityPercent      Float  @default(20)
  auditPercent        Float  @default(20)
  deliveryPercent     Float  @default(20)
  carClosurePercent   Float  @default(20)
  documentationPercent Float @default(20)
  updatedAt           DateTime @updatedAt
}

model RiskSnapshot {
  id         String    @id @default(cuid())
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  score      Float?
  level      RiskLevel
  createdAt  DateTime  @default(now())
}

enum RiskLevel {
  Low
  Medium
  High
}

model Opportunity {
  id          String   @id @default(cuid())
  code        String   @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type        RiskItemType
  description String
  likelihood  RiskLikelihood?
  severity    RiskSeverity?
  riskLevel   RiskLevel?
  status      RiskStatus @default(Open)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  actions     RiskAction[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RiskAction {
  id                 String           @id @default(cuid())
  code               String           @unique
  supplierId         String
  supplier           Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  riskId             String
  risk               Opportunity      @relation(fields: [riskId], references: [id], onDelete: Cascade)
  description        String
  owner              String?
  dueDate            DateTime?        @db.Date
  status             RiskActionStatus @default(Open)
  residualLikelihood RiskLikelihood?
  residualSeverity   RiskSeverity?
  residualRiskLevel  RiskLevel?
  createdById        String?
  createdBy          User?            @relation(fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

// ============== Legal content (Terms & Privacy) ==============
model LegalDocument {
  key       String   @id // 'terms' or 'privacy'
  title     String
  content   String   // markdown or plain text
  updatedAt DateTime @updatedAt
}

enum RiskItemType {
  risk
  opportunity
}

enum RiskStatus {
  Open
  Mitigated
  Closed
  Realized
}

enum RiskLikelihood {
  VeryUnlikely
  Unlikely
  Possible
  Likely
  VeryLikely
}

enum RiskSeverity {
  Negligible
  Minor
  Moderate
  Significant
  Severe
}

enum RiskActionStatus {
  Open
  InProgress
  Mitigated
}

// ============== Alerts ==============
model Alert {
  id         String       @id @default(cuid())
  category   AlertCategory
  entityType String?      // e.g. Audit, Finding, CAR, Shipment
  entityId   String?
  message    String?
  userId     String?      // if user-specific
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
}

enum AlertCategory {
  overdueAudit
  majorCriticalFinding
  overdueCAR
  shipmentInspectionRequest
  rejectedShipmentDocument
  lateShipment
}

model UserAlertPreference {
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertCategory AlertCategory
  enabled      Boolean @default(true)
  @@id([userId, alertCategory])
}

// ============== Global Vendors (farms / farmers) ==============
model Farm {
  id     String @id @default(cuid())
  code   String @unique // FARM-00001
  farmName   String
  farmerName String
  country    String
  city       String?

  latitude        Float?
  longitude       Float?
  region          String?
  farmCategory    String?
  mainCrop        String?
  elevationMeters Float?
  productionStyle String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([country])
}

model Expense {
  id          String   @id @default(cuid())
  type        String
  description String
  project     String
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([project])
  @@index([type])
  @@index([createdAt])
}

// For application-level code generation (SUP-00001, AUD-00001, etc.)
model IdSequence {
  prefix    String @id // SUP, AUD, TYP, FIN, CAR, RISK, OPP, ACT, FARM
  lastValue Int    @default(0)
}
