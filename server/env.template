# Copy this file to `server/.env` (same folder as package.json), OR create `.env` in the repo root.
# The API loads, in order: `../.env` (parent of cwd), `./.env`, `server/.env` — see `src/app.ts`.
# After saving, restart the server (`npm run dev`).

# --- Required for Prisma / PostgreSQL (Supabase or local Postgres) ---
# Local example (adjust user, password, port, database name):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sentinel?schema=public"
#
# Supabase: use the connection strings from Project Settings → Database.
# Often DATABASE_URL uses the pooler; DIRECT_URL should be the direct db host (port 5432).
DATABASE_URL=
DIRECT_URL=

# --- Auth (required for login tokens) ---
JWT_SECRET=change-me-to-a-long-random-string-in-development
